# PatchPilot 环境变量示例（复制为 .env 或在平台控制台填写；.env 已被 gitignore）

# ---- Nebius Token Factory + NVIDIA Nemotron（深度审查；不配置则用离线 Linter）----
NEBIUS_API_KEY=
NEBIUS_BASE=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# ---- 可选：Tavily 检索增强（Best Use of Tavily）----
TAVILY_API_KEY=

# ---- 服务端口（Render/大部分 PaaS 自动注入）----
PORT=8000
